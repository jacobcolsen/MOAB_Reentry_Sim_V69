{
  "name": "moab-reentry-sim-v69",
  "version": "69.0.0",
  "description": "Reentry Trajectory Simulation & Visualization",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.moab.reentry.sim.v69",
    "productName": "MOAB_Reentry_Sim_V69",
    "files": [
      "main.js",
      "reentry_simulation_apollo10_physics.html",
      "reentry_trajectory_viz_integrated.html"
    ],
    "directories": {
      "output": "."
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ]
    },
    "dmg": {
      "title": "Reentry Viewer",
      "contents": [
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 150, "type": "file" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    }
  }
}
